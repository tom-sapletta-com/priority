{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subactor.io/schemas/ticket-context-selection.schema.json",
  "title": "Ticket Context Selection",
  "type": "object",
  "required": ["schema", "generatedAt", "ticketId", "requestDigest", "ecosystemMapDigest", "status", "roleAssignment", "selectedProjects", "findings", "contextDigest"],
  "properties": {
    "schema": {"const": "subactor.ticket-context-selection/v1"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "ticketId": {"type": "string"},
    "requestDigest": {"type": "string", "pattern": "^sha256:"},
    "ecosystemMapDigest": {"type": "string", "pattern": "^sha256:"},
    "status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCK"]},
    "tokens": {"type": "array", "items": {"type": "string"}},
    "roleAssignment": {"type": "object", "additionalProperties": {"type": "string"}},
    "selectedProjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "score", "roles", "interfaces", "evidenceStatus", "executionEligible"],
        "properties": {
          "id": {"type": "string"},
          "score": {"type": "number"},
          "reasons": {"type": "array", "items": {"type": "string"}},
          "roles": {"type": "array", "items": {"type": "string"}},
          "homeFor": {"type": "array", "items": {"type": "string"}},
          "interfaces": {"type": "object"},
          "evidenceStatus": {"type": "string"},
          "sourceRank": {"type": "integer"},
          "executionEligible": {"type": "boolean"},
          "manifestStatus": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "excludedProjects": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "contextDigest": {"type": "string", "pattern": "^sha256:"}
  },
  "additionalProperties": false
}
