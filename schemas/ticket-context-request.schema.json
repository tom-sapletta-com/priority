{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.io/schemas/ticket-context-request.schema.json",
  "title": "Ticket Context Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ticketId", "intent", "requiredRoles", "acceptanceCriteria"],
  "properties": {
    "schema": {"const": "subactor.ticket-context-request/v1"},
    "ticketId": {"type": "string", "pattern": "^ticket-[A-Za-z0-9._-]+$"},
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "taskKind"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "taskKind": {"enum": ["code-change", "refactor", "release", "standard-change", "offer-change", "research"]},
        "objectives": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "concerns": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "tags": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "requiredRoles": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "preferredProjects": {"type": "array", "items": {"type": "string", "pattern": "^[^/]+/[^/]+$"}},
    "excludedProjects": {"type": "array", "items": {"type": "string", "pattern": "^[^/]+/[^/]+$"}},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "maxProjects": {"type": "integer", "minimum": 1, "maximum": 20}
  }
}
